.milestone-bar {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.milestone-track {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
}

/* 连接线背景 */
.milestone-track::before {
  content: '';
  position: absolute;
  top: 28rpx;
  left: 40rpx;
  right: 40rpx;
  height: 4rpx;
  background: #E8E8E8;
  z-index: 0;
}

/* 每个里程碑节点 */
.milestone-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
  width: 12.5%;
  flex-shrink: 0;
}

.milestone-item.completed .milestone-dot {
  background: #1A6D5C;
  border-color: #1A6D5C;
}

.milestone-item.completed .milestone-name {
  color: #1A6D5C;
}

.milestone-item.current .milestone-dot {
  background: #1A6D5C;
  border-color: #1A6D5C;
  box-shadow: 0 0 0 6rpx rgba(26, 109, 92, 0.2);
  transform: scale(1.1);
}

.milestone-item.current .milestone-name {
  color: #1A6D5C;
  font-weight: 600;
}

/* 节点圆点 */
.milestone-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 4rpx solid #D9D9D9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.dot-check {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.dot-icon {
  font-size: 24rpx;
  line-height: 1;
}

.dot-empty {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #D9D9D9;
}

/* 里程碑名称 */
.milestone-name {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
  white-space: nowrap;
  transition: color 0.3s ease;
}