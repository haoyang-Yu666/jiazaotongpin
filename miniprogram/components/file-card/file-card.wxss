.file-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease;
}

.file-card:active {
  transform: scale(0.98);
}

/* 文件预览区域 */
.file-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #F5F5F5;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.file-icon {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF6B6B, #EE5A24);
}

.icon-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* 版本标签 */
.version-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  color: #FFFFFF;
  font-weight: 600;
  background: rgba(0, 0, 0, 0.5);
}

.version-tag.version-V1 {
  background: rgba(26, 109, 92, 0.85);
}

.version-tag.version-V2 {
  background: rgba(42, 157, 143, 0.85);
}

.version-tag.version-V3 {
  background: rgba(82, 196, 26, 0.85);
}

.version-tag.version-final {
  background: rgba(250, 173, 20, 0.9);
}

/* 文件信息 */
.file-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.file-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.file-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.category-label {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #E8F5F0;
  color: #1A6D5C;
  margin-right: 12rpx;
  font-weight: 500;
}

.file-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.file-status.status-pending {
  background: #FFF7E6;
  color: #FAAD14;
}

.file-status.status-confirmed {
  background: #F6FFED;
  color: #52C41A;
}

.file-status.status-rejected {
  background: #FFF1F0;
  color: #FF4D4F;
}

.file-date {
  font-size: 22rpx;
  color: #999999;
}