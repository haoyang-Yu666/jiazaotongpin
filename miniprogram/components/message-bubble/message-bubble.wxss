.bubble-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding: 0 24rpx;
}

.row-self {
  justify-content: flex-end;
}

.row-other {
  justify-content: flex-start;
}

.bubble-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #F5F5F5;
}

.bubble-content {
  max-width: 70%;
  margin: 0 16rpx;
  display: flex;
  flex-direction: column;
}

.row-self .bubble-content {
  align-items: flex-end;
}

.row-other .bubble-content {
  align-items: flex-start;
}

.bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  word-break: break-all;
}

.bubble-self {
  background: #1A6D5C;
  border-top-right-radius: 4rpx;
}

.bubble-other {
  background: #ffffff;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.text-self {
  color: #ffffff;
}

.text-other {
  color: #333333;
}

.bubble-image-wrap {
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.bubble-image {
  width: 320rpx;
  display: block;
}

.bubble-time {
  font-size: 20rpx;
  color: #BBBBBB;
  margin-top: 6rpx;
}

.time-self {
  text-align: right;
}

.time-other {
  text-align: left;
}
