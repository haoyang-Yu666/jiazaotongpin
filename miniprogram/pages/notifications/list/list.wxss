.notification-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #F0F0F0;
}

.unread-text {
  font-size: 26rpx;
  color: #999999;
}

.read-all-btn {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(26, 109, 92, 0.08);
}

.read-all-text {
  font-size: 24rpx;
  color: #1A6D5C;
  font-weight: 500;
}

/* 通知列表 */
.notification-scroll {
  height: calc(100vh - 80rpx);
}

.notification-list {
  padding: 16rpx 24rpx;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  position: relative;
}

.notification-item.unread {
  background: rgba(26, 109, 92, 0.03);
  border-left: 6rpx solid #1A6D5C;
}

.notif-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.icon-text {
  font-size: 32rpx;
}

.notif-content {
  flex: 1;
  min-width: 0;
}

.notif-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.notif-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notif-time {
  font-size: 22rpx;
  color: #CCCCCC;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.notif-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notif-project {
  font-size: 22rpx;
  color: #1A6D5C;
  margin-top: 8rpx;
  display: inline-block;
  background: rgba(26, 109, 92, 0.06);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.notif-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.delete-icon {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #CCCCCC;
}
