<view class="add-page">
  <!-- 图片区域 -->
  <view class="section">
    <text class="section-title">图片</text>
    <image-uploader
      imageList="{{imageList}}"
      maxCount="{{maxImages}}"
      bind:change="onImageChange"
    />
  </view>

  <!-- 描述 -->
  <view class="section">
    <text class="section-title">描述</text>
    <textarea
      class="desc-input"
      placeholder="描述一下这个灵感..."
      value="{{description}}"
      bindinput="onDescriptionInput"
      maxlength="200"
    />
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button class="btn-primary submit-btn" bindtap="onSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '发布灵感'}}
    </button>
  </view>
</view>
