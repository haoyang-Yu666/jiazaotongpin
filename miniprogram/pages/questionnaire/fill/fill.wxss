.fill-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* 表单滚动区 */
.form-scroll {
  height: 100vh;
  padding: 20rpx 24rpx 140rpx;
}

/* 表单区块 */
.form-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 4rpx;
  display: block;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

/* 表单组 */
.form-group {
  margin-bottom: 20rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.required {
  color: #FF4D4F;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 76rpx;
  font-size: 28rpx;
  color: #333;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 选择器 */
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 76rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #bbb;
}

.picker-arrow {
  font-size: 28rpx;
  color: #999;
}

/* 标签多选 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag-item {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  background: #F5F5F5;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tag-item.active {
  background: rgba(26, 109, 92, 0.08);
  border-color: #1A6D5C;
}

.tag-text {
  font-size: 26rpx;
  color: #666;
}

.tag-item.active .tag-text {
  color: #1A6D5C;
  font-weight: 500;
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}

/* 提交按钮 */
.form-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.submit-btn {
  width: 100%;
}

.submit-btn[disabled] {
  opacity: 0.7;
}
