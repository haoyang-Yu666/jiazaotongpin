<view class="fill-page">
  <scroll-view class="form-scroll" scroll-y show-scrollbar="{{false}}">
    <!-- 居住信息 -->
    <view class="form-section">
      <text class="section-header">居住信息</text>

      <view class="form-group">
        <text class="form-label">常住人口 <text class="required">*</text></text>
        <input
          class="form-input"
          placeholder="例: 3人 (夫妻+1个孩子)"
          value="{{form.residents}}"
          data-field="residents"
          bindinput="onInputChange"
        />
      </view>

      <view class="form-group">
        <text class="form-label">家庭结构 <text class="required">*</text></text>
        <input
          class="form-input"
          placeholder="例: 夫妻30岁+男孩5岁"
          value="{{form.familyStructure}}"
          data-field="familyStructure"
          bindinput="onInputChange"
        />
      </view>
    </view>

    <!-- 核心需求 -->
    <view class="form-section">
      <text class="section-header">核心需求</text>
      <text class="section-hint">可多选</text>

      <view class="tag-group">
        <button
          class="tag-btn {{form.coreNeeds[item] ? 'tag-active' : ''}}"
          wx:for="{{coreNeedsOptions}}"
          wx:key="*this"
          data-need="{{item}}"
          bindtap="onCoreNeedToggle"
        >
          {{item}}
        </button>
      </view>
    </view>

    <!-- 风格偏好 -->
    <view class="form-section">
      <text class="section-header">风格偏好</text>

      <view class="form-group">
        <text class="form-label">喜欢的风格</text>
        <picker
          mode="selector"
          range="{{styleOptions}}"
          value="{{form.styleIndex}}"
          bindchange="onStyleChange"
        >
          <view class="form-picker">
            <text class="picker-value {{form.stylePreference ? '' : 'placeholder'}}">
              {{form.stylePreference || '请选择风格'}}
            </text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">喜欢的颜色</text>
        <input
          class="form-input"
          placeholder="例: 喜欢暖色调、原木色"
          value="{{form.colorPreference}}"
          data-field="colorPreference"
          bindinput="onInputChange"
        />
      </view>
    </view>

    <!-- 预算范围 -->
    <view class="form-section">
      <text class="section-header">预算范围</text>

      <view class="form-group">
        <text class="form-label">装修预算</text>
        <picker
          mode="selector"
          range="{{budgetOptions}}"
          value="{{form.budgetIndex}}"
          bindchange="onBudgetChange"
        >
          <view class="form-picker">
            <text class="picker-value {{form.budgetRange ? '' : 'placeholder'}}">
              {{form.budgetRange || '请选择预算范围'}}
            </text>
            <text class="picker-arrow">></text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 特别要求 -->
    <view class="form-section">
      <text class="section-header">特别要求</text>

      <view class="form-group">
        <text class="form-label">特殊需求</text>
        <textarea
          class="form-textarea"
          placeholder="请描述特殊需求，如老人房、宠物空间等"
          value="{{form.specialRequirements}}"
          data-field="specialRequirements"
          bindinput="onInputChange"
          maxlength="500"
          auto-height
        />
        <view class="image-upload-area">
          <text class="image-upload-hint">上传参考图（最多3张）</text>
          <image-uploader
            imageList="{{form.specialImages}}"
            maxCount="3"
            bind:change="onSpecialImagesChange"
          />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">不喜欢的元素</text>
        <textarea
          class="form-textarea"
          placeholder="请描述不喜欢的元素或风格"
          value="{{form.dislikedElements}}"
          data-field="dislikedElements"
          bindinput="onInputChange"
          maxlength="300"
          auto-height
        />
        <view class="image-upload-area">
          <text class="image-upload-hint">上传参考图（最多3张）</text>
          <image-uploader
            imageList="{{form.dislikedImages}}"
            maxCount="3"
            bind:change="onDislikedImagesChange"
          />
        </view>
      </view>
    </view>

    <!-- 按房间详细需求 -->
    <view class="form-section">
      <text class="section-header">按房间偏好</text>
      <text class="section-hint">可选，为每个房间单独设定偏好和上传参考图</text>

      <view
        class="room-card {{expandedRoom === index ? 'room-expanded' : ''}}"
        wx:for="{{rooms}}"
        wx:key="room_type"
        data-index="{{index}}"
      >
        <view class="room-header" data-index="{{index}}" bindtap="onRoomToggle">
          <text class="room-name">{{item.room_label}}</text>
          <text class="room-arrow">{{expandedRoom === index ? '−' : '+'}}</text>
        </view>

        <view class="room-body" wx:if="{{expandedRoom === index}}">
          <view class="form-group">
            <text class="form-label">风格偏好</text>
            <input
              class="form-input"
              placeholder="例: 简约、温馨"
              value="{{item.style_preference}}"
              data-index="{{index}}"
              data-field="style_preference"
              bindinput="onRoomInput"
            />
          </view>
          <view class="form-group">
            <text class="form-label">颜色偏好</text>
            <input
              class="form-input"
              placeholder="例: 浅灰+白色"
              value="{{item.color_preference}}"
              data-index="{{index}}"
              data-field="color_preference"
              bindinput="onRoomInput"
            />
          </view>
          <view class="form-group">
            <text class="form-label">特殊要求</text>
            <textarea
              class="form-textarea"
              placeholder="这个房间有什么特别的需求？"
              value="{{item.special_requirements}}"
              data-index="{{index}}"
              data-field="special_requirements"
              bindinput="onRoomInput"
              maxlength="200"
              auto-height
            />
          </view>
          <view class="form-group">
            <text class="form-label">参考图（最多3张）</text>
            <image-uploader
              imageList="{{item.reference_images}}"
              maxCount="3"
              data-index="{{index}}"
              bind:change="onRoomImageChange"
            />
          </view>
        </view>
      </view>
    </view>

    <!-- 设计师自定义问题 -->
    <view class="form-section" wx:if="{{customQuestions.length > 0}}">
      <text class="section-header">设计师提问</text>
      <text class="section-hint">设计师为你准备了以下问题</text>

      <view class="custom-question" wx:for="{{customQuestions}}" wx:key="_qi">
        <text class="custom-q-text">{{item._qi + 1}}. {{item.question}} <text class="required" wx:if="{{item.required}}">*</text></text>

        <!-- 短文本 -->
        <input
          wx:if="{{item.type === 'text'}}"
          class="form-input custom-input"
          placeholder="请输入"
          value="{{customAnswers[item._qi]}}"
          data-index="{{item._qi}}"
          bindinput="onCustomInput"
        />

        <!-- 多行文本 -->
        <textarea
          wx:if="{{item.type === 'textarea'}}"
          class="form-textarea custom-input"
          placeholder="请输入"
          value="{{customAnswers[item._qi]}}"
          data-index="{{item._qi}}"
          bindinput="onCustomInput"
          maxlength="500"
          auto-height
        />

        <!-- 单选 -->
        <view class="tag-group" wx:if="{{item.type === 'single_select'}}">
          <button
            class="tag-btn {{customAnswers[item._qi] === opt ? 'tag-active' : ''}}"
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="*this"
            data-index="{{item._qi}}"
            data-option="{{opt}}"
            bindtap="onCustomSelect"
          >
            {{opt}}
          </button>
        </view>

        <!-- 多选 -->
        <view class="tag-group" wx:if="{{item.type === 'multi_select'}}">
          <button
            class="tag-btn {{customActive[item._qi][opt] ? 'tag-active' : ''}}"
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="*this"
            data-index="{{item._qi}}"
            data-option="{{opt}}"
            bindtap="onCustomMultiToggle"
          >
            {{opt}}
          </button>
        </view>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 提交按钮 -->
  <view class="form-footer">
    <button
      class="btn-primary submit-btn"
      bindtap="onSubmit"
      loading="{{submitting}}"
      disabled="{{submitting}}"
    >
      提交问卷
    </button>
  </view>
</view>
