<view class="view-page">
  <!-- 加载中 -->
  <view class="loading-area" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>

  <block wx:if="{{!loading && questionnaire}}">
    <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <!-- 提交时间 -->
      <view class="submit-info">
        <text class="submit-time" wx:if="{{submitTime}}">提交时间: {{submitTime}}</text>
        <text class="review-badge" wx:if="{{reviewed}}">已阅</text>
      </view>

      <!-- 居住信息 -->
      <view class="view-section">
        <text class="section-header">居住信息</text>
        <view class="field-row">
          <text class="field-label">常住人口</text>
          <text class="field-value">{{questionnaire.residents || '未填写'}}</text>
        </view>
        <view class="field-divider"></view>
        <view class="field-row">
          <text class="field-label">家庭结构</text>
          <text class="field-value">{{questionnaire.familyStructure || '未填写'}}</text>
        </view>
      </view>

      <!-- 核心需求 -->
      <view class="view-section">
        <text class="section-header">核心需求</text>
        <view class="tags-display" wx:if="{{questionnaire.coreNeeds && questionnaire.coreNeeds.length > 0}}">
          <view
            class="display-tag"
            wx:for="{{questionnaire.coreNeeds}}"
            wx:key="*this"
          >
            <text class="tag-text">{{item}}</text>
          </view>
        </view>
        <text class="empty-field" wx:else>未选择</text>
      </view>

      <!-- 风格偏好 -->
      <view class="view-section">
        <text class="section-header">风格偏好</text>
        <view class="field-row">
          <text class="field-label">喜欢的风格</text>
          <text class="field-value">{{questionnaire.stylePreference || '未选择'}}</text>
        </view>
        <view class="field-divider"></view>
        <view class="field-row">
          <text class="field-label">喜欢的颜色</text>
          <text class="field-value">{{questionnaire.colorPreference || '未填写'}}</text>
        </view>
      </view>

      <!-- 预算范围 -->
      <view class="view-section">
        <text class="section-header">预算范围</text>
        <view class="field-row">
          <text class="field-label">装修预算</text>
          <text class="field-value">{{questionnaire.budgetRange || '未选择'}}</text>
        </view>
      </view>

      <!-- 特别要求 -->
      <view class="view-section">
        <text class="section-header">特别要求</text>
        <view class="field-block">
          <text class="field-label">特殊需求</text>
          <text class="field-content">{{questionnaire.specialRequirements || '无'}}</text>
          <view class="room-images" wx:if="{{questionnaire.specialImages && questionnaire.specialImages.length > 0}}">
            <view class="image-grid">
              <image
                class="room-ref-image"
                wx:for="{{questionnaire.specialImages}}"
                wx:for-item="imgUrl"
                wx:key="*this"
                src="{{imgUrl}}"
                mode="aspectFill"
                data-url="{{imgUrl}}"
                data-urls="{{questionnaire.specialImages}}"
                bindtap="onPreviewRoomImage"
                binderror="onImageError"
              />
            </view>
          </view>
        </view>
        <view class="field-divider"></view>
        <view class="field-block">
          <text class="field-label">不喜欢的元素</text>
          <text class="field-content">{{questionnaire.dislikedElements || '无'}}</text>
          <view class="room-images" wx:if="{{questionnaire.dislikedImages && questionnaire.dislikedImages.length > 0}}">
            <view class="image-grid">
              <image
                class="room-ref-image"
                wx:for="{{questionnaire.dislikedImages}}"
                wx:for-item="imgUrl"
                wx:key="*this"
                src="{{imgUrl}}"
                mode="aspectFill"
                data-url="{{imgUrl}}"
                data-urls="{{questionnaire.dislikedImages}}"
                bindtap="onPreviewRoomImage"
                binderror="onImageError"
              />
            </view>
          </view>
        </view>
      </view>

      <!-- 按房间详情 -->
      <view class="view-section" wx:if="{{questionnaire.rooms && questionnaire.rooms.length > 0}}">
        <text class="section-header">按房间偏好</text>
        <view class="room-detail" wx:for="{{questionnaire.rooms}}" wx:key="room_type">
          <text class="room-detail-title">{{item.room_type}}</text>
          <view class="field-row" wx:if="{{item.style_preference}}">
            <text class="field-label">风格</text>
            <text class="field-value">{{item.style_preference}}</text>
          </view>
          <view class="field-row" wx:if="{{item.color_preference}}">
            <text class="field-label">颜色</text>
            <text class="field-value">{{item.color_preference}}</text>
          </view>
          <view class="field-block" wx:if="{{item.special_requirements}}">
            <text class="field-label">特殊要求</text>
            <text class="field-content">{{item.special_requirements}}</text>
          </view>
          <view class="room-images" wx:if="{{item.reference_images && item.reference_images.length > 0}}">
            <text class="field-label">参考图</text>
            <view class="image-grid">
              <image
                class="room-ref-image"
                wx:for="{{item.reference_images}}"
                wx:for-item="imgUrl"
                wx:key="*this"
                src="{{imgUrl}}"
                mode="aspectFill"
                data-url="{{imgUrl}}"
                data-urls="{{item.reference_images}}"
                bindtap="onPreviewRoomImage"
                binderror="onImageError"
              />
            </view>
          </view>
          <view class="field-divider" wx:if="{{index < questionnaire.rooms.length - 1}}"></view>
        </view>
      </view>

      <!-- 设计师自定义问题 -->
      <view class="view-section" wx:if="{{questionnaire.snapshotQuestions && questionnaire.snapshotQuestions.length > 0}}">
        <text class="section-header">设计师提问</text>
        <view class="custom-qa" wx:for="{{questionnaire.snapshotQuestions}}" wx:key="_qi">
          <text class="custom-q">{{item._qi + 1}}. {{item.question}}</text>
          <block wx:if="{{item.type === 'text' || item.type === 'textarea'}}">
            <text class="custom-a">{{questionnaire.customAnswers[item._qi] || '未填写'}}</text>
          </block>
          <block wx:if="{{item.type === 'single_select'}}">
            <view class="tags-display" wx:if="{{questionnaire.customAnswers[item._qi]}}">
              <view class="display-tag">
                <text class="tag-text">{{questionnaire.customAnswers[item._qi]}}</text>
              </view>
            </view>
            <text class="custom-a" wx:else>未选择</text>
          </block>
          <block wx:if="{{item.type === 'multi_select'}}">
            <view class="tags-display" wx:if="{{questionnaire.customAnswers[item._qi].length > 0}}">
              <view class="display-tag" wx:for="{{questionnaire.customAnswers[item._qi]}}" wx:for-item="opt" wx:key="*this">
                <text class="tag-text">{{opt}}</text>
              </view>
            </view>
            <text class="custom-a" wx:else>未选择</text>
          </block>
          <view class="field-divider" wx:if="{{item._qi < questionnaire.snapshotQuestions.length - 1}}"></view>
        </view>
      </view>

      <!-- 底部留白 -->
      <view class="bottom-space"></view>
    </scroll-view>

    <!-- 设计师：标记已阅 -->
    <view class="view-footer" wx:if="{{isDesigner && !reviewed}}">
      <button class="btn-primary mark-btn" catchtap="markReviewed">
        标记已阅
      </button>
    </view>

    <!-- 设计师：已标记已阅 -->
    <view class="view-footer reviewed-footer" wx:if="{{isDesigner && reviewed}}">
      <text class="reviewed-text">已标记已阅</text>
    </view>

    <!-- 客户：修改问卷 -->
    <view class="view-footer" wx:if="{{!isDesigner}}">
      <button class="btn-outline edit-btn" bindtap="onEditQuestionnaire">
        修改问卷
      </button>
    </view>
  </block>
</view>
