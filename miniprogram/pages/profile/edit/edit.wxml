<view class="edit-page">
  <!-- 头像 -->
  <view class="avatar-section">
    <view class="avatar-wrap">
      <image class="avatar-img" src="{{avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
      <view class="avatar-edit-icon">
        <text class="edit-text">编辑</text>
      </view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar"></button>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-section">
    <view class="form-group">
      <text class="form-label">昵称</text>
      <input
        class="form-input"
        type="nickname"
        placeholder="请输入昵称"
        value="{{nickname}}"
        bindinput="onNicknameInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        type="number"
        placeholder="请输入手机号"
        value="{{phone}}"
        bindinput="onPhoneInput"
        maxlength="11"
      />
    </view>

    <view class="form-group" wx:if="{{isDesigner}}">
      <text class="form-label">公司/工作室</text>
      <input
        class="form-input"
        placeholder="请输入公司名称"
        value="{{company}}"
        bindinput="onCompanyInput"
      />
    </view>

    <view class="form-group">
      <text class="form-label">职位</text>
      <input
        class="form-input"
        placeholder="如：主案设计师、设计总监"
        value="{{position}}"
        bindinput="onPositionInput"
      />
    </view>

    <block wx:if="{{isDesigner}}">
      <view class="form-group">
        <text class="form-label">擅长风格</text>
        <input
          class="form-input"
          placeholder="如：现代简约、北欧风、新中式"
          value="{{styles}}"
          bindinput="onStylesInput"
        />
      </view>

      <view class="form-group">
        <text class="form-label">个人简介</text>
        <textarea
          class="form-textarea"
          placeholder="简单介绍一下自己，让客户更了解你"
          value="{{bio}}"
          bindinput="onBioInput"
          maxlength="200"
          auto-height
        />
      </view>
    </block>

    <view class="form-group">
      <text class="form-label">邮箱</text>
      <input
        class="form-input"
        type="text"
        placeholder="请输入邮箱"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>

    <view class="form-group" wx:if="{{isDesigner}}">
      <text class="form-label">微信号</text>
      <input
        class="form-input"
        placeholder="方便客户联系你"
        value="{{wechat}}"
        bindinput="onWechatInput"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="submit-area">
    <button class="btn-primary submit-btn" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">
      保存
    </button>
  </view>
</view>
