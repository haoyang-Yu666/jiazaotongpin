.profile-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* 头部渐变背景 */
.profile-header {
  background: linear-gradient(180deg, #1A6D5C 0%, #0D4F42 100%);
  height: 280rpx;
  border-radius: 0 0 60rpx 60rpx;
}

/* 用户信息卡片 - 与header重叠 */
.profile-card {
  position: relative;
  z-index: 1;
  margin: -120rpx 32rpx 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  margin-top: -70rpx;
  margin-bottom: 16rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.user-position {
  font-size: 26rpx;
  color: #1A6D5C;
  margin-bottom: 12rpx;
}

.role-badge {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
}

.badge-designer {
  background: #E8F5F0;
}

.badge-designer .role-text {
  color: #1A6D5C;
}

.badge-client {
  background: #F5EDE4;
}

.badge-client .role-text {
  color: #D4A574;
}

.role-text {
  font-size: 24rpx;
  font-weight: 500;
}

.user-phone {
  margin-top: 12rpx;
}

.phone-text {
  font-size: 26rpx;
  color: #999999;
}

.user-company {
  margin-top: 6rpx;
}

.company-text {
  font-size: 26rpx;
  color: #999999;
}

/* 菜单 */
.menu-section {
  margin: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8f8f8;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon-text {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-label {
  font-size: 30rpx;
  color: #1A1A1A;
}

.menu-arrow {
  font-size: 28rpx;
  color: #999999;
}

/* 退出登录 */
.logout-section {
  margin: 40rpx 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid #FF4D4F;
  border-radius: 16rpx;
  color: #FF4D4F;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0;
  box-sizing: border-box;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: #FFF5F5;
}

.version-info {
  text-align: center;
  padding: 40rpx 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.version-text {
  font-size: 24rpx;
  color: #CCCCCC;
}
