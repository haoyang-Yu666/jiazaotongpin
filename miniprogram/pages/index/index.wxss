.index-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f5f5 0%, #e8f0ee 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 60rpx;
}

/* 品牌区域 */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.logo-box {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #1A6D5C 0%, #0D4F42 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(26, 109, 92, 0.3);
}

.logo-text {
  font-size: 88rpx;
  color: #ffffff;
  font-weight: 700;
}

.app-title {
  font-size: 52rpx;
  color: #1A1A1A;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999999;
}

/* 角色选择 */
.role-area {
  width: 100%;
}

.role-btn {
  width: 100%;
  padding: 36rpx 40rpx;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  display: flex;
  flex-direction: column;
  position: relative;
}

.role-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.role-designer {
  background: linear-gradient(135deg, #1A6D5C 0%, #0D4F42 100%);
  box-shadow: 0 8rpx 32rpx rgba(26, 109, 92, 0.25);
}

.role-designer .role-icon,
.role-designer .role-label,
.role-designer .role-desc {
  color: #ffffff;
}

.role-designer .role-desc {
  opacity: 0.7;
}

.role-client {
  background: #ffffff;
  border: 2rpx solid #1A6D5C;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.role-client .role-label {
  color: #1A6D5C;
}

.role-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.role-label {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #666666;
}

/* 底部 */
.footer-area {
  margin-top: 80rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #bbbbbb;
}
