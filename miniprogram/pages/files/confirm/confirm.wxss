.confirm-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 140rpx;
}

/* 大图预览 */
.large-preview {
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 0;
}

.image-swiper {
  width: 100%;
  height: 500rpx;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

/* PDF 卡片 */
.pdf-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.pdf-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.pdf-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.pdf-action {
  font-size: 26rpx;
  color: #1A6D5C;
}

/* 元数据卡片 */
.meta-card {
  margin: 20rpx 24rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.meta-row:last-child {
  border-bottom: none;
}

.meta-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.meta-value {
  font-size: 28rpx;
  color: #333;
  text-align: right;
  word-break: break-all;
}

.meta-value.desc {
  color: #666;
}

/* 确认历史 */
.history-section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.timeline {
  margin-top: 16rpx;
}

.timeline-item {
  display: flex;
  padding: 16rpx 0;
  position: relative;
}

.timeline-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1A6D5C;
  flex-shrink: 0;
  margin-top: 8rpx;
  margin-right: 20rpx;
  position: relative;
}

.timeline-item:not(:last-child) .timeline-dot::after {
  content: '';
  position: absolute;
  top: 20rpx;
  left: 6rpx;
  width: 4rpx;
  height: calc(100% + 16rpx);
  background: #e8e8e8;
}

.timeline-content {
  flex: 1;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-user {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.timeline-action {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.action-pass {
  color: #52C41A;
  background: rgba(82, 196, 26, 0.1);
}

.action-reject {
  color: #FF4D4F;
  background: rgba(255, 77, 79, 0.1);
}

.timeline-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 底部操作按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.reject-btn {
  flex: 1;
  color: #FF4D4F;
  border-color: #FF4D4F;
}

.confirm-btn {
  flex: 1;
}
