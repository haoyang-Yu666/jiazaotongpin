.preview-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 20rpx 24rpx;
}

/* 文件头部 */
.file-header {
  margin-bottom: 20rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.file-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
  margin-right: 16rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
}

.header-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  flex-direction: column;
}

.meta-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.meta-value {
  font-size: 26rpx;
  color: #333;
}

/* 预览区域 */
.preview-area {
  margin-bottom: 20rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-img {
  width: 100%;
  height: 500rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
}

/* PDF 预览 */
.pdf-preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.pdf-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.pdf-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.pdf-hint {
  font-size: 26rpx;
  color: #1A6D5C;
}

/* 操作区域 */
.action-area {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
}

.action-btn {
  flex: 1;
  font-size: 30rpx;
}

.reject-btn {
  color: #FF4D4F;
  border-color: #FF4D4F;
}

/* 详细确认链接 */
.detail-confirm-area {
  text-align: center;
  padding: 16rpx 0;
}

.detail-link {
  font-size: 26rpx;
  color: #1A6D5C;
}
