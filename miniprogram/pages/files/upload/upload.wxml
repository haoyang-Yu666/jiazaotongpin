<view class="upload-page">
  <view class="form-section">
    <!-- 标题 -->
    <view class="form-group">
      <text class="form-label">文件标题</text>
      <input
        class="form-input"
        placeholder="请输入文件标题"
        value="{{title}}"
        bindinput="onTitleInput"
        maxlength="50"
      />
    </view>

    <!-- 文件类型切换 -->
    <view class="form-group">
      <text class="form-label">文件类型</text>
      <view class="mode-switch">
        <view
          class="mode-btn {{isImageMode ? 'mode-active' : ''}}"
          data-mode="image"
          bindtap="onModeSwitch"
          hover-class="mode-hover"
        >
          <text class="mode-icon">🖼️</text>
          <text>图片</text>
        </view>
        <view
          class="mode-btn {{!isImageMode ? 'mode-active' : ''}}"
          data-mode="file"
          bindtap="onModeSwitch"
          hover-class="mode-hover"
        >
          <text class="mode-icon">📄</text>
          <text>文档</text>
        </view>
      </view>
    </view>

    <!-- 文件选择 -->
    <view class="form-group">
      <text class="form-label">选择文件</text>

      <!-- 图片选择 -->
      <view wx:if="{{isImageMode}}" class="file-picker">
        <view
          class="image-picker-area"
          wx:if="{{imageList.length === 0}}"
          bindtap="onChooseImage"
          hover-class="picker-hover"
        >
          <text class="picker-icon">📷</text>
          <text class="picker-text">点击选择图片</text>
          <text class="picker-hint">支持拍照或从相册选取</text>
        </view>
        <view class="image-preview" wx:else>
          <image class="preview-image" src="{{imageList[0]}}" mode="aspectFill" />
          <view class="remove-btn" bindtap="onRemoveFile" hover-class="remove-hover">
            <text class="remove-icon">✕</text>
          </view>
          <view class="preview-bar" bindtap="onChooseImage" hover-class="preview-bar-hover">
            <text class="preview-bar-text">点击替换图片</text>
          </view>
        </view>
      </view>

      <!-- 文档选择 -->
      <view wx:if="{{!isImageMode}}" class="file-picker">
        <view
          class="file-picker-area"
          wx:if="{{!fileUrl}}"
          bindtap="onChooseFile"
          hover-class="picker-hover"
        >
          <text class="picker-icon">📁</text>
          <text class="picker-text">点击选择文档</text>
          <text class="picker-hint">支持 PDF、图片格式</text>
          <view class="picker-tip-box">
            <text class="picker-tip-icon">💡</text>
            <text class="picker-tip-text">请先将文件发送到微信"文件传输助手"，再返回此处选择</text>
          </view>
        </view>
        <view class="file-preview" wx:else>
          <view class="file-info-row">
            <text class="file-icon">📄</text>
            <view class="file-info-text">
              <text class="file-name">{{fileName}}</text>
              <text class="file-meta">{{fileType === 'pdf' ? 'PDF 文档' : '图片'}}</text>
            </view>
          </view>
          <view class="remove-btn" bindtap="onRemoveFile" hover-class="remove-hover">
            <text class="remove-icon">✕</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分类 -->
    <view class="form-group">
      <text class="form-label">文件分类</text>
      <radio-group class="radio-group" bindchange="onCategoryChange">
        <label
          class="radio-item {{category === item.value ? 'radio-active' : ''}}"
          wx:for="{{categoryOptions}}"
          wx:key="value"
        >
          <radio value="{{item.value}}" checked="{{category === item.value}}" color="#1A6D5C" />
          <text class="radio-label">{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <!-- 版本 -->
    <view class="form-group">
      <text class="form-label">版本号</text>
      <picker
        class="form-picker"
        range="{{versionOptions}}"
        value="{{versionIndex}}"
        bindchange="onVersionChange"
      >
        <view class="picker-content">
          <text class="picker-value">{{version}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 描述 -->
    <view class="form-group">
      <text class="form-label">描述说明</text>
      <textarea
        class="form-textarea"
        placeholder="请输入文件描述（选填）"
        value="{{description}}"
        bindinput="onDescriptionInput"
        maxlength="200"
        auto-height
      />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button
      class="btn-primary submit-btn"
      bindtap="onSubmit"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      上传文件
    </button>
  </view>
</view>