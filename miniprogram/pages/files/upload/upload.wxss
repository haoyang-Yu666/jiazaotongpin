.upload-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.form-section {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  border: 2rpx solid #EEEEEE;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  border: 2rpx solid #EEEEEE;
}

.file-picker-area {
  width: 100%;
  height: 240rpx;
  border: 2rpx dashed #EEEEEE;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.file-picker-text {
  font-size: 28rpx;
  color: #999999;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
  background: #ffffff;
}

.radio-item.active {
  border-color: #1A6D5C;
  color: #1A6D5C;
  background: #E8F5F0;
}

.submit-btn {
  width: 100%;
  margin-top: 40rpx;
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.picker-area {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #EEEEEE;
}

.picker-text {
  font-size: 28rpx;
  color: #1A1A1A;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999999;
}
