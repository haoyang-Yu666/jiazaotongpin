.upload-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 24rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ========== 表单区块 ========== */
.form-section {
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  border: 2rpx solid #EEEEEE;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  border: 2rpx solid #EEEEEE;
  box-sizing: border-box;
}

/* ========== 文件类型切换（分段控件） ========== */
.mode-switch {
  display: flex;
  background: #EEEEEE;
  border-radius: 12rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.mode-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #666666;
  transition: all 0.2s;
  gap: 8rpx;
}

.mode-icon {
  font-size: 32rpx;
  line-height: 1;
}

.mode-hover {
  opacity: 0.7;
}

.mode-active {
  background: #ffffff;
  color: #1A6D5C;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

/* ========== 文件选择区 ========== */
.file-picker {
  width: 100%;
}

/* 未选择：虚线大框 */
.image-picker-area,
.file-picker-area {
  width: 100%;
  height: 260rpx;
  border: 2rpx dashed #CCCCCC;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: border-color 0.2s;
}

.image-picker-area:active,
.file-picker-area:active {
  border-color: #1A6D5C;
  background: #F9FFFC;
}

.picker-icon {
  font-size: 64rpx;
  line-height: 1;
}

.picker-text {
  font-size: 28rpx;
  color: #666666;
}

.picker-hint {
  font-size: 24rpx;
  color: #999999;
}

.picker-hover {
  border-color: #1A6D5C !important;
  background: #F6FFFB !important;
}

/* 文档选择提示条 */
.picker-tip-box {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  background: #FFF8E6;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  margin-top: 8rpx;
  max-width: 90%;
}

.picker-tip-icon {
  font-size: 24rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.picker-tip-text {
  font-size: 22rpx;
  color: #B8860B;
  line-height: 1.5;
}

/* 已选择：图片预览 */
.image-preview {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

/* 点击替换栏 */
.preview-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 64rpx;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-bar-text {
  color: #ffffff;
  font-size: 24rpx;
}

.preview-bar-hover {
  background: rgba(0,0,0,0.65);
}

/* 已选择：文件信息 */
.file-preview {
  position: relative;
  width: 100%;
  background: #ffffff;
  border: 2rpx solid #1A6D5C;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
}

.file-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.file-icon {
  font-size: 48rpx;
}

.file-info-text {
  flex: 1;
  min-width: 0;
}

.file-name {
  font-size: 28rpx;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.file-meta {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-top: 4rpx;
}

/* 移除按钮 */
.remove-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 48rpx;
  height: 48rpx;
  background: #FF4D4F;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(255,77,79,0.3);
}

.remove-hover {
  transform: scale(1.1);
}

.remove-icon {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}

/* ========== 分类单选 ========== */
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border: 2rpx solid #EEEEEE;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #666666;
  background: #ffffff;
  transition: all 0.2s;
}

.radio-active {
  border-color: #1A6D5C;
  color: #1A6D5C;
  background: #E8F5F0;
}

.radio-label {
  font-size: 26rpx;
}

/* ========== 版本选择器 ========== */
.form-picker {
  width: 100%;
}

.picker-content {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #EEEEEE;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  line-height: 24rpx;
  color: #1A1A1A;
  position: relative;
  top: -10rpx;
}

.picker-arrow {
  font-size: 24rpx;
  line-height: 24rpx;
  color: #999999;
  position: relative;
  top: -10rpx;
}

/* ========== 提交按钮 ========== */
.submit-area {
  margin-top: 40rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1A6D5C, #228B6A);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(26,109,92,0.25);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.submit-btn {
  margin-top: 0;
}
