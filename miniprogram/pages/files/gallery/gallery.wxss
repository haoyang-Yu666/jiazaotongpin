.gallery-page {
  min-height: 100vh;
  background: #000000;
  display: flex;
  flex-direction: column;
}

.gallery-counter {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.counter-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.4);
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
}

.gallery-swiper {
  flex: 1;
}

.image-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
}

.action-btn {
  padding: 16rpx 48rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 40rpx;
}

.action-text {
  font-size: 28rpx;
  color: #ffffff;
}
