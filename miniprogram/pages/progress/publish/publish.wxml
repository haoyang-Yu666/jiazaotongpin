<view class="publish-page">
  <view class="form-section">
    <!-- 里程碑选择 -->
    <view class="form-group">
      <text class="form-label">关联里程碑</text>
      <picker
        class="form-picker"
        range="{{milestones}}"
        range-key="name"
        value="{{selectedStage}}"
        bindchange="onStageChange"
      >
        <view class="picker-content">
          <text class="picker-value">{{milestones[selectedStage].name}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 日志内容 -->
    <view class="form-group">
      <text class="form-label">日志内容</text>
      <textarea
        class="form-textarea"
        placeholder="请输入施工日志内容..."
        value="{{content}}"
        bindinput="onContentInput"
        maxlength="1000"
        auto-height
      />
      <view class="char-count">
        <text class="count-text">{{content.length}}/1000</text>
      </view>
    </view>

    <!-- 图片上传 -->
    <view class="form-group">
      <text class="form-label">施工照片（最多{{maxImages}}张）</text>
      <image-uploader
        imageList="{{imageList}}"
        maxCount="{{maxImages}}"
        bind:change="onImageChange"
      />
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="submit-area">
    <button
      class="btn-primary submit-btn"
      bindtap="onSubmit"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      发布日志
    </button>
  </view>
</view>
