.dashboard-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.loading-area {
  padding-top: 200rpx;
  display: flex;
  justify-content: center;
}

/* 项目标题 */
.project-title-bar {
  background: linear-gradient(135deg, #1A6D5C, #0D4F42);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}

.title-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.title-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 区块卡片 */
.section-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  display: block;
}

/* 进度条 */
.stage-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.stage-bar {
  flex: 1;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.stage-fill {
  height: 100%;
  background: linear-gradient(90deg, #1A6D5C, #2A9D8F);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.stage-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A6D5C;
}

.stage-hint {
  font-size: 24rpx;
  color: #999999;
}

/* 统计卡片行 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A6D5C;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

.stat-sub {
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 4rpx;
}

/* 快捷操作 */
.action-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 32rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
}

.action-item:active {
  background: #EEEEEE;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333333;
}

/* 最近动态 */
.log-list {
  padding-left: 24rpx;
  border-left: 4rpx solid #1A6D5C;
}

.log-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  position: relative;
}

.log-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #1A6D5C;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 8rpx;
  position: relative;
  left: -32rpx;
}

.log-info {
  flex: 1;
  margin-left: -24rpx;
}

.log-content {
  font-size: 28rpx;
  color: #333333;
  display: block;
  line-height: 1.5;
}

.log-time {
  font-size: 22rpx;
  color: #CCCCCC;
  margin-top: 4rpx;
  display: block;
}
