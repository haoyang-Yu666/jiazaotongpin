.invite-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* 加载 */
.loading-area {
  height: 60vh;
}

/* 错误状态 */
.error-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  padding: 0 48rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FF4D4F;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 32rpx;
  color: #1A1A1A;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.error-hint {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
}

/* 内容区 */
.invite-content {
  padding: 32rpx;
}

/* 头部 */
.invite-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.header-decor {
  width: 80rpx;
  height: 6rpx;
  background: #1A6D5C;
  border-radius: 3rpx;
  margin: 0 auto 20rpx;
}

.invite-title {
  font-size: 34rpx;
  color: #1A1A1A;
  font-weight: 600;
}

/* 项目信息卡片 */
.project-info-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 28rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 500;
}

.info-divider {
  height: 1rpx;
  background: #F0F0F0;
  margin: 12rpx 0;
}

/* 邀请码 */
.invite-code-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.code-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 12rpx;
}

.code-box {
  padding: 16rpx 48rpx;
  background: #E8F5F0;
  border-radius: 12rpx;
  border: 2rpx dashed #1A6D5C;
}

.code-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A6D5C;
  letter-spacing: 8rpx;
}

/* 加入按钮 */
.join-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.join-btn[disabled] {
  opacity: 0.7;
}

.join-hint {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}
