<view class="project-list-page">
  <!-- 视角切换 -->
  <view class="view-tabs" wx:if="{{userRole === 'designer'}}">
    <view
      class="view-tab {{currentRole === item.key ? 'active' : ''}}"
      wx:for="{{viewTabs}}"
      wx:key="key"
      data-role="{{item.key}}"
      bindtap="onViewSwitch"
    >
      <text class="view-tab-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索项目名称"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
      confirm-type="search"
    />
  </view>

  <!-- 状态筛选 -->
  <scroll-view class="filter-bar" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      class="filter-item {{statusFilter === item.key ? 'filter-active' : ''}}"
      wx:for="{{statusFilters}}"
      wx:key="key"
      data-status="{{item.key}}"
      bindtap="onStatusFilter"
    >
      <text class="filter-text">{{item.label}}</text>
    </view>
    <view
      class="filter-item sort-toggle"
      bindtap="onSortToggle"
    >
      <text class="filter-text">{{sortBy === 'updated_at' ? '最近更新' : '最新创建'}}</text>
    </view>
  </scroll-view>

  <!-- 项目列表 -->
  <view class="project-content">
    <!-- 骨架屏 -->
    <skeleton wx:if="{{loading && projects.length === 0}}" type="project" count="4" />

    <!-- 空状态 -->
    <empty-state
      wx:if="{{!loading && isEmpty && currentRole === 'designer'}}"
      type="project"
      message="暂无设计项目"
      description="点击下方按钮创建新项目"
    />
    <empty-state
      wx:if="{{!loading && isEmpty && currentRole === 'client'}}"
      type="project"
      message="暂无参与项目"
      description="点击下方按钮加入项目"
    />

    <!-- 项目卡片列表 -->
    <scroll-view
      wx:if="{{!isEmpty}}"
      class="project-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      bindscrolltolower="onLoadMore"
      lower-threshold="200"
    >
      <view class="project-list">
        <project-card
          wx:for="{{projects}}"
          wx:key="_id"
          data-id="{{item._id}}"
          project="{{item}}"
          bindtap="onProjectTap"
        />
      </view>
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{loading && projects.length > 0}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
      <view class="load-more" wx:if="{{!hasMore && projects.length > 0}}">
        <text class="no-more-text">没有更多了</text>
      </view>
    </scroll-view>
  </view>

  <!-- 新建项目 -->
  <view
    class="fab-btn"
    wx:if="{{currentRole === 'designer'}}"
    bindtap="onCreateProject"
  >
    <text class="fab-icon">+</text>
    <text class="fab-label">新建项目</text>
  </view>

  <!-- 加入项目 -->
  <view
    class="fab-btn fab-join"
    wx:if="{{currentRole === 'client'}}"
    bindtap="onShowJoinDialog"
  >
    <text class="fab-icon">+</text>
    <text class="fab-label">加入项目</text>
  </view>

  <!-- 加入项目弹窗 -->
  <view class="dialog-mask" wx:if="{{showJoinDialog}}" bindtap="onHideJoinDialog"></view>
  <view class="dialog-box" wx:if="{{showJoinDialog}}">
    <text class="dialog-title">加入项目</text>
    <text class="dialog-hint">请输入设计师提供的6位邀请码</text>
    <input
      class="dialog-input"
      maxlength="6"
      placeholder="请输入邀请码"
      value="{{inviteCode}}"
      bindinput="onInviteCodeInput"
    />
    <view class="dialog-actions">
      <view class="dialog-btn dialog-cancel" bindtap="onHideJoinDialog">
        <text>取消</text>
      </view>
      <view class="dialog-btn dialog-confirm" bindtap="onJoinProject">
        <text>加入</text>
      </view>
    </view>
  </view>
</view>
