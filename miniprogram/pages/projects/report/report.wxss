.report-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

.report-canvas {
  position: fixed;
  left: -9999rpx;
  width: 540px;
  height: 1200px;
}

.loading-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E0E0E0;
  border-top-color: #1A6D5C;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999999;
}

.preview-area {
  padding: 24rpx;
}

.preview-image {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.1);
}

.report-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 20rpx;
  z-index: 10;
}

.save-btn {
  flex: 1;
}

.share-btn {
  flex: 1;
}

.btn-outline {
  background: #ffffff;
  color: #1A6D5C;
  border: 2rpx solid #1A6D5C;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 20rpx 0;
  text-align: center;
}

.btn-outline::after {
  border: none;
}
