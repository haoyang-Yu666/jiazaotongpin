.detail-page {
  min-height: 100vh;
  background-color: #F5F5F5;
}

/* 项目头部 - 绿色渐变 */
.project-header {
  background: linear-gradient(180deg, #1A6D5C 0%, #0D4F42 100%);
  padding: 32rpx 32rpx 40rpx;
  border-radius: 0 0 60rpx 60rpx;
  color: #ffffff;
}

.header-info {
  display: flex;
  flex-direction: column;
}

.project-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.project-meta {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.meta-dot {
  margin: 0 12rpx;
  color: rgba(255, 255, 255, 0.4);
}

.project-status {
  display: flex;
  align-items: center;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-waiting {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.status-active {
  background: rgba(82, 196, 26, 0.3);
  color: #b7eb8f;
}

.status-completed {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.8);
}

.invite-code-btn {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.9);
}

.invite-code-btn:active {
  background: rgba(255, 255, 255, 0.25);
}

/* 头部操作按钮 */
.header-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.header-action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.15);
}

.header-action-btn:active {
  background: rgba(255, 255, 255, 0.25);
}

.header-share-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  font-size: 26rpx;
  color: #ffffff;
  padding: 0;
  margin: 0;
  line-height: 64rpx;
}

.header-share-btn::after {
  border: none;
}

.action-label {
  font-size: 26rpx;
  color: #ffffff;
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #ffffff;
  position: relative;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
  border-radius: 20rpx 20rpx 0 0;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.tab-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #1A6D5C;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 33.33%;
  height: 6rpx;
  display: flex;
  justify-content: center;
  transition: transform 0.3s ease;
}

.tab-line::after {
  content: '';
  width: 48rpx;
  height: 6rpx;
  background: #1A6D5C;
  border-radius: 3rpx;
}

/* Tab 内容 */
.tab-content {
  height: calc(100vh - 360rpx);
}

.tab-scroll {
  height: 100%;
}

.tab-inner {
  padding: 24rpx 32rpx;
  padding-bottom: 160rpx;
}

/* 通用 section 卡片 */
.section-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  display: block;
}

/* 问卷状态卡片 */
.questionnaire-status-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.qs-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 24rpx;
  text-align: center;
}

.qs-btn {
  width: 60%;
  font-size: 28rpx;
}

.qs-hint {
  font-size: 26rpx;
  color: #999999;
}

/* 灵感板入口 */
.inspiration-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.entry-label {
  font-size: 28rpx;
  color: #1A6D5C;
  font-weight: 500;
}

.entry-arrow {
  font-size: 28rpx;
  color: #999999;
}

/* 文件分类筛选 */
.category-filter {
  white-space: nowrap;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.filter-item {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.filter-item.active {
  background: #1A6D5C;
}

.filter-text {
  font-size: 26rpx;
  color: #666666;
}

.filter-item.active .filter-text {
  color: #ffffff;
}

/* 文件列表 */
.file-list .file-item {
  margin-bottom: 16rpx;
}

/* 上传按钮区域 */
.upload-area {
  margin-top: 24rpx;
}

.upload-btn {
  width: 100%;
}

/* 进度日志 */
.log-list .log-item {
  margin-bottom: 16rpx;
}

/* 发布按钮 */
.publish-area {
  margin-top: 24rpx;
}

.publish-btn {
  width: 100%;
}
