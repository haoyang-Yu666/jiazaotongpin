.poster-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  width: 540px;
  height: 800px;
}

.poster-preview {
  padding: 32rpx;
  width: 100%;
  box-sizing: border-box;
}

.poster-image {
  width: 100%;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.generating {
  padding: 200rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.generating-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
}

.poster-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  gap: 20rpx;
}

.save-btn, .share-btn {
  flex: 1;
  font-size: 28rpx;
}
