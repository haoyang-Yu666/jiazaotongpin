.login-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 头部渐变区域 */
.login-header {
  background: linear-gradient(180deg, #1A6D5C 0%, #0D4F42 100%);
  border-radius: 0 0 60rpx 60rpx;
  padding-bottom: 60rpx;
}

.header-bg {
  display: none;
}

.avatar-area {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.avatar-wrapper {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
}

.avatar-btn {
  display: flex;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
  position: relative;
  border-radius: 50%;
  overflow: hidden;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  color: #fff;
  font-size: 22rpx;
  line-height: 1;
}

.role-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #ffffff;
}

.role-tag-designer {
  background: rgba(255, 255, 255, 0.2);
}

.role-tag-client {
  background: rgba(212, 165, 116, 0.5);
}

/* 内容区 - 白色背景 */
.login-body {
  padding: 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #ffffff;
  margin: -30rpx 24rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.welcome-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.welcome-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #666666;
}

/* 表单区域 */
.form-area {
  width: 100%;
  margin-bottom: 36rpx;
}

.input-group {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.input-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  display: block;
}

.nickname-input {
  font-size: 30rpx;
  color: #1A1A1A;
  height: 60rpx;
  line-height: 60rpx;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #1A6D5C;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  background: #1A6D5C;
  opacity: 0.7;
  color: #ffffff;
}

/* 底部提示 */
.login-tips {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
}

.tip-text {
  font-size: 22rpx;
  color: #999999;
}

.tip-link {
  font-size: 22rpx;
  color: #1A6D5C;
}
